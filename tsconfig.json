{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@boss/BossController": ["src/bosses/BossController.ts"]
    }
  },
  "include": ["src", "debug", "scripts", "types", "tools"],
  "references": [{ "path": "tsconfig.node.json" }]
}
